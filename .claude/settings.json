{
  "permissions": {
    "deny": [
      "Read(**/build/classes/**)",
      "Read(**/build/libs/**)",
      "Read(**/build/tmp/**)",
      "Read(**/build/generated/**)",
      "Read(**/build/resources/**)",
      "Read(**/build/kotlin/**)",
      "Read(**/build/distributions/**)",
      "Read(**/build/dist/**)",
      "Edit(**/build/**)",
      "Read(**/.gradle/**)",
      "Edit(**/.gradle/**)",
      "Read(**/out/**)",
      "Edit(**/out/**)",
      "Read(**/bin/**)",
      "Edit(**/bin/**)",
      "Read(**/.idea/**)",
      "Edit(**/.idea/**)",
      "Read(**/.vscode/**)",
      "Edit(**/.vscode/**)",
      "Read(**/.kotlin/**)",
      "Edit(**/.kotlin/**)",
      "Read(**/node_modules/**)",
      "Edit(**/node_modules/**)",
      "Read(**/target/**)",
      "Edit(**/target/**)",
      "Read(**/classes/**)",
      "Edit(**/classes/**)",
      "Bash(git push:*)"
    ],
    "allow": [
      "Read(**/build/test-results/**)",
      "Bash(git status:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show-ref:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git stash:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(./gradlew:*)"
    ]
  },
  "enabledPlugins": {
    "jdtls-lsp@claude-plugins-official": true
  }
}
